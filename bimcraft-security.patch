+# Hostile file fuzzing
+
+Install cargo-fuzz and a nightly Rust toolchain, then run from this folder:
+
+```sh
+cargo +nightly fuzz run hostile_files -- -max_len=1048576 -timeout=10 -rss_limit_mb=2048
+```
+
+Seed corpus with synthetic BIMCraft JSON, IFC STEP and CFB headers. Never commit proprietary Revit files. This target covers project/IFC decoding and Revit container construction and gzip member inflation, not full Revit import or every parser path. Run in an isolated worker with CPU/memory/time limits; size limits alone do not bound algorithmic complexity. Preserve minimized crashes as regression fixtures.
diff --git a/fuzz/fuzz_targets/hostile_files.rs b/fuzz/fuzz_targets/hostile_files.rs
new file mode 100644
index 0000000..443eda4
--- /dev/null
+++ b/fuzz/fuzz_targets/hostile_files.rs
@@ -0,0 +1,18 @@
+#![no_main]
+use libfuzzer_sys::fuzz_target;
+
+fuzz_target!(|data: &[u8]| {
+    if data.len() > 1 << 20 { return; }
+    // Do not catch panics here: a panic is a fuzz finding.
+    if let Ok(text) = std::str::from_utf8(data) {
+        let _ = bimcraft_core::model::Model::read(text);
+    }
+    let _ = bimcraft_core::import::ifc(data, "fuzz");
+    let _ = bimcraft_rvt::gzip::inflate_first(data, 1 << 20);
+    let _ = bimcraft_rvt::gzip::inflate_members(data, 1 << 20);
+    let limits = bimcraft_rvt::Limits {
+        max_file: 1 << 20, max_streams: 32,
+        max_stream: 1 << 20, max_inflated: 1 << 20,
+    };
+    let _ = bimcraft_rvt::Revit::from_bytes(data.to_vec(), limits);
+});

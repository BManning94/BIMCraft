diff --git a/.github/workflows/patched-windows.yml b/.github/workflows/patched-windows.yml
new file mode 100644
index 0000000..7aa2352
--- /dev/null
+++ b/.github/workflows/patched-windows.yml
@@ -0,0 +1,52 @@
+name: Patched Windows build
+on:
+  push:
+    branches: ["security/harden-untrusted-input"]
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  windows:
+    runs-on: windows-latest
+    timeout-minutes: 90
+    env:
+      CARGO_TERM_COLOR: always
+    steps:
+      - uses: actions/checkout@v4
+      - name: Rust tools
+        run: rustup update stable && rustup default stable && rustup component add rustfmt clippy
+      - name: Format source
+        run: cargo fmt --all
+      - name: Check formatting
+        run: cargo fmt --all --check
+      - name: Lint
+        run: cargo clippy --locked --workspace --all-targets -- -D warnings
+      - name: Regression tests
+        run: cargo test --locked --workspace
+      - name: Build Windows programs
+        env:
+          CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_RUSTFLAGS: -C target-feature=+crt-static
+        run: cargo build --release --locked --target x86_64-pc-windows-msvc -p bimcraft -p bimcraft-cli
+      - name: Check programs and package
+        shell: pwsh
+        run: |
+          $bin = 'target/x86_64-pc-windows-msvc/release'
+          & "$bin/bimcraft.exe" --version
+          if ($LASTEXITCODE -ne 0) { throw 'Desktop version check failed' }
+          & "$bin/bimcraft-cli.exe" --version
+          if ($LASTEXITCODE -ne 0) { throw 'CLI version check failed' }
+          New-Item -ItemType Directory -Force dist | Out-Null
+          Copy-Item "$bin/bimcraft.exe", "$bin/bimcraft-cli.exe" dist/
+          Copy-Item LICENSE-MIT, LICENSE-APACHE dist/
+          Copy-Item crates/rvt/NOTICE dist/REVIT-READER-NOTICE.txt
+          Copy-Item docs/security-local-review.md dist/SECURITY-REVIEW.md
+          Set-Content dist/BUILD-COMMIT.txt $env:GITHUB_SHA
+          Get-ChildItem dist/*.exe | Get-FileHash -Algorithm SHA256 | ForEach-Object { "$($_.Hash.ToLower())  $([IO.Path]::GetFileName($_.Path))" } | Set-Content dist/SHA256SUMS.txt
+          git diff --output=dist/formatting.patch
+      - name: Downloadable Windows app
+        uses: actions/upload-artifact@v4
+        with:
+          name: BIMCraft-patched-Windows-x64
+          path: dist/
+          if-no-files-found: error
+          retention-days: 14

diff --git a/crates/ui-egui/src/lumion.rs b/crates/ui-egui/src/lumion.rs
new file mode 100644
index 0000000..feadede
--- /dev/null
+++ b/crates/ui-egui/src/lumion.rs
@@ -0,0 +1,178 @@
+//! User-started local IPC only. No network listener, shell, script or automatic startup.
+use std::io::{BufRead, BufReader, Read, Write};
+use std::process::{Child, Command, Stdio};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Condvar, Mutex, mpsc};
+use std::time::Duration;
+
+use bimcraft_core::model::Model;
+use bimcraft_core::view3d::lumion::{encode, snapshot};
+use egui::{Context, Ui};
+
+use crate::lang::{t, tf};
+use crate::{BimApp, Status};
+
+struct Pending {
+    model: Mutex<Option<Arc<Model>>>,
+    wake: Condvar,
+    stopped: AtomicBool,
+}
+
+pub(crate) struct LiveSync {
+    pending: Arc<Pending>,
+    child: Arc<Mutex<Child>>,
+    messages: mpsc::Receiver<(String, bool)>,
+    last: Arc<Model>,
+}
+
+fn start(model: &Arc<Model>) -> Result<LiveSync, String> {
+    if !cfg!(windows) {
+        return Err("Lumion LiveSync requires Windows.".into());
+    }
+    let exe = std::env::current_exe().map_err(|e| e.to_string())?;
+    let folder = exe.parent().ok_or("Could not locate the application folder.")?.join("lumion");
+    let bridge = folder.join("BIMCraft-Lumion-Bridge.exe");
+    if !bridge.is_file() {
+        return Err("The optional Lumion bridge is missing from the application's lumion folder.".into());
+    }
+    let mut command = Command::new(bridge);
+    command.current_dir(folder).stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::null());
+    #[cfg(windows)]
+    {
+        use std::os::windows::process::CommandExt;
+        command.creation_flags(0x0800_0000); // CREATE_NO_WINDOW
+    }
+    let mut child = command.spawn().map_err(|e| format!("Could not start the Lumion bridge: {e}"))?;
+    let input = child.stdin.take();
+    let output = child.stdout.take();
+    let (Some(mut input), Some(output)) = (input, output) else {
+        let _ = child.kill();
+        let _ = child.wait();
+        return Err("Could not create the Lumion bridge pipes.".into());
+    };
+    let child = Arc::new(Mutex::new(child));
+    let pending = Arc::new(Pending { model: Mutex::new(Some(Arc::clone(model))), wake: Condvar::new(), stopped: AtomicBool::new(false) });
+    let (sender, messages) = mpsc::sync_channel(32);
+    let worker = Arc::clone(&pending);
+    let errors = sender.clone();
+    std::thread::spawn(move || {
+        while !worker.stopped.load(Ordering::Relaxed) {
+            let model = {
+                let Ok(mut slot) = worker.model.lock() else { break };
+                if slot.is_none() {
+                    let Ok((next, _)) = worker.wake.wait_timeout(slot, Duration::from_millis(500)) else { break };
+                    slot = next;
+                }
+                slot.take()
+            };
+            let Some(model) = model else { continue };
+            let result = snapshot(&model).and_then(|frame| encode(&frame)).and_then(|data| {
+                let length = u32::try_from(data.len()).map_err(|e| e.to_string())?;
+                input.write_all(&length.to_le_bytes()).and_then(|()| input.write_all(&data)).and_then(|()| input.flush())
+                    .map_err(|e| format!("Lumion bridge disconnected: {e}"))
+            });
+            if let Err(error) = result {
+                let _ = errors.try_send((error, true));
+                worker.stopped.store(true, Ordering::Relaxed);
+            }
+            // Coalesce edits while a snapshot is being constructed; never queue old scenes.
+            std::thread::sleep(Duration::from_millis(350));
+        }
+        // Closing the pipe asks the bridge to delete only its own LiveSync document.
+    });
+    let reader_stop = Arc::clone(&pending);
+    std::thread::spawn(move || {
+        let mut reader = BufReader::new(output);
+        loop {
+            let mut line = Vec::new();
+            let result = Read::by_ref(&mut reader).take(8193).read_until(b'\n', &mut line);
+            match result {
+                Ok(0) => break,
+                Ok(_) if line.len() <= 8192 => {
+                    if let Ok(value) = serde_json::from_slice::<serde_json::Value>(&line) {
+                        if let (Some(status), Some(message)) = (value["status"].as_str(), value["message"].as_str()) {
+                            let _ = sender.try_send((message.to_owned(), status == "error"));
+                        }
+                    }
+                }
+                _ => {
+                    let _ = sender.try_send(("Invalid response from the Lumion bridge.".into(), true));
+                    break;
+                }
+            }
+        }
+        if !reader_stop.stopped.swap(true, Ordering::Relaxed) {
+            let _ = sender.try_send(("The Lumion bridge has stopped.".into(), true));
+        }
+        reader_stop.wake.notify_one();
+    });
+    Ok(LiveSync { pending, child, messages, last: Arc::clone(model) })
+}
+
+impl LiveSync {
+    fn changed(&mut self, model: &Arc<Model>) {
+        if self.pending.stopped.load(Ordering::Relaxed) || Arc::ptr_eq(model, &self.last) {
+            return;
+        }
+        if let Ok(mut slot) = self.pending.model.lock() {
+            *slot = Some(Arc::clone(model));
+            self.last = Arc::clone(model);
+            self.pending.wake.notify_one();
+        }
+    }
+}
+
+impl Drop for LiveSync {
+    fn drop(&mut self) {
+        self.pending.stopped.store(true, Ordering::Relaxed);
+        self.pending.wake.notify_one();
+        let child = Arc::clone(&self.child);
+        std::thread::spawn(move || {
+            // Permit EOF cleanup, then terminate a stalled bridge without holding the desktop.
+            std::thread::sleep(Duration::from_secs(2));
+            if let Ok(mut child) = child.lock() {
+                if !matches!(child.try_wait(), Ok(Some(_))) {
+                    let _ = child.kill();
+                }
+                let _ = child.wait();
+            }
+        });
+    }
+}
+
+impl BimApp {
+    pub(crate) fn lumion_menu(&mut self, ui: &mut Ui) {
+        if self.lumion.is_some() {
+            if ui.button(t("Stop Lumion LiveSync")).clicked() {
+                self.lumion = None;
+                self.status = Status { text: t("Lumion LiveSync stopped.").into(), error: false };
+            }
+        } else if ui.add_enabled(cfg!(windows), egui::Button::new(t("Start Lumion LiveSync"))).clicked() {
+            match start(&self.session.model) {
+                Ok(sync) => {
+                    self.lumion = Some(sync);
+                    self.status = Status { text: t("Starting Lumion LiveSync…").into(), error: false };
+                }
+                Err(error) => self.status = Status { text: tf("Lumion LiveSync: {}", &[&error]), error: true },
+            }
+        }
+    }
+
+    pub(crate) fn poll_lumion(&mut self, ctx: &Context) {
+        let Some(sync) = self.lumion.as_mut() else { return };
+        sync.changed(&self.session.model);
+        for (message, error) in sync.messages.try_iter() {
+            self.status = Status { text: tf("Lumion LiveSync: {}", &[&message]), error };
+        }
+        ctx.request_repaint_after(Duration::from_millis(500));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn live_sync_is_opt_in_and_does_not_start_with_the_desktop() {
+        let app = super::BimApp::new(bimcraft_core::engine::Session::new());
+        assert!(app.lumion.is_none());
+    }
+}

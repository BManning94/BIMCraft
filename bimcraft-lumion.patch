--- /dev/null
+++ b/fuzz/fuzz_targets/hostile_files.rs
@@ -0,0 +1,18 @@
+#![no_main]
+use libfuzzer_sys::fuzz_target;
+
+fuzz_target!(|data: &[u8]| {
+    if data.len() > 1 << 20 { return; }
+    // Do not catch panics here: a panic is a fuzz finding.
+    if let Ok(text) = std::str::from_utf8(data) {
+        let _ = bimcraft_core::model::Model::read(text);
+    }
+    let _ = bimcraft_core::import::ifc(data, "fuzz");
+    let _ = bimcraft_rvt::gzip::inflate_first(data, 1 << 20);
+    let _ = bimcraft_rvt::gzip::inflate_members(data, 1 << 20);
+    let limits = bimcraft_rvt::Limits {
+        max_file: 1 << 20, max_streams: 32,
+        max_stream: 1 << 20, max_inflated: 1 << 20,
+    };
+    let _ = bimcraft_rvt::Revit::from_bytes(data.to_vec(), limits);
+});
diff --git a/tools/lumion-bridge/Bridge.cs b/tools/lumion-bridge/Bridge.cs
new file mode 100644
index 0000000..96b22cb
--- /dev/null
+++ b/tools/lumion-bridge/Bridge.cs
@@ -0,0 +1,228 @@
+// Optional local adapter. No vendor binaries or Revit host code are included in this repository.
+using System;
+using System.Collections;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Reflection;
+using System.Security.Cryptography;
+using System.Web.Script.Serialization;
+
+sealed class Frame {
+    public int version { get; set; }
+    public Mesh[] meshes { get; set; }
+    public Material[] materials { get; set; }
+}
+sealed class Mesh {
+    public string key { get; set; }
+    public string material { get; set; }
+    public float[] positions { get; set; }
+    public float[] normals { get; set; }
+}
+sealed class Material {
+    public string key { get; set; }
+    public float[] color { get; set; }
+}
+sealed class Entry {
+    public object Writer;
+    public object Asset;
+    public ulong Node;
+}
+static class Bridge {
+    const int MaxFrame = 64 * 1024 * 1024;
+    const int MaxTriangles = 150000;
+    static readonly JavaScriptSerializer Json = new JavaScriptSerializer { MaxJsonLength = MaxFrame, RecursionLimit = 32 };
+    static Assembly Engine;
+    static object Document;
+    static readonly Dictionary<string, Entry> Meshes = new Dictionary<string, Entry>();
+    static readonly Dictionary<string, Entry> Materials = new Dictionary<string, Entry>();
+    static ulong NextNode = 1;
+    static bool Initialized;
+
+    static int Main(string[] args) {
+        try {
+            if (args.Length != 0) throw new InvalidDataException("This bridge only accepts framed snapshots on standard input.");
+            LoadEngine();
+            if (Call(T("ActApp"), "GetNewestActiveLumion") == null)
+                throw new InvalidOperationException("Open Lumion to a scene before starting LiveSync.");
+            Document = Call(T("DocumentCreator"), "CreateDocument", "BIMCraft", E("DocumentType", "LiveSync"), E("ActAppType", "Lumion"));
+            if (Document == null) throw new InvalidOperationException("Could not create the LiveSync document.");
+            Call(Document, "SetMetadata", "{\"application\":\"BIMCraft\",\"units\":\"metres\",\"up\":\"Y\"}");
+            Report("ready", "LiveSync document created; reception is not yet confirmed.");
+            using (Stream input = Console.OpenStandardInput()) {
+                byte[] data;
+                while ((data = ReadFrame(input)) != null) {
+                    Frame frame = Json.Deserialize<Frame>(new System.Text.UTF8Encoding(false, true).GetString(data));
+                    Validate(frame);
+                    Publish(frame);
+                }
+            }
+            return 0;
+        } catch (Exception ex) {
+            while (ex is TargetInvocationException && ex.InnerException != null) ex = ex.InnerException;
+            Report("error", ex.Message);
+            return 1;
+        } finally {
+            if (Document != null) {
+                try { Call(T("DocumentCreator"), "DeleteDocument", Get(Document, "DocumentId")); } catch { }
+                Dispose(Document);
+            }
+            foreach (Entry entry in Materials.Values) Dispose(entry.Asset);
+        }
+    }
+
+    static void LoadEngine() {
+        string folder = AppDomain.CurrentDomain.BaseDirectory;
+        Check(Path.Combine(folder, "LiveSyncEngineNET.dll"), "0B39DDAEF0AF9F4AF8BE2F7A0CB6AB8190D3E5559FFDCECF4F894374A1F63A48");
+        Check(Path.Combine(folder, "LiveSyncCoreNET.dll"), "7020CF8A6D93FC935BB06324989C52F891534621D78E0C827D658E71ECB48991");
+        Assembly.LoadFrom(Path.Combine(folder, "LiveSyncCoreNET.dll"));
+        Engine = Assembly.LoadFrom(Path.Combine(folder, "LiveSyncEngineNET.dll"));
+    }
+    static void Check(string file, string expected) {
+        using (var sha = SHA256.Create())
+        using (var stream = File.OpenRead(file)) {
+            if (BitConverter.ToString(sha.ComputeHash(stream)).Replace("-", "") != expected)
+                throw new InvalidDataException("Unsupported or modified LiveSync DLL: " + Path.GetFileName(file));
+        }
+    }
+    internal static byte[] ReadFrame(Stream stream) {
+        byte[] header = new byte[4];
+        int first = stream.ReadByte();
+        if (first < 0) return null;
+        header[0] = (byte)first;
+        ReadExact(stream, header, 1, 3);
+        uint size = (uint)header[0] | ((uint)header[1] << 8) | ((uint)header[2] << 16) | ((uint)header[3] << 24);
+        if (size == 0 || size > MaxFrame) throw new InvalidDataException("Invalid LiveSync frame length.");
+        byte[] data = new byte[(int)size];
+        ReadExact(stream, data, 0, data.Length);
+        return data;
+    }
+    static void ReadExact(Stream stream, byte[] data, int offset, int count) {
+        while (count > 0) {
+            int got = stream.Read(data, offset, count);
+            if (got == 0) throw new EndOfStreamException("Truncated LiveSync frame.");
+            offset += got; count -= got;
+        }
+    }
+    internal static void Validate(Frame frame) {
+        if (frame == null || frame.version != 1 || frame.meshes == null || frame.materials == null ||
+            frame.meshes.Length > 50000 || frame.materials.Length > 50000)
+            throw new InvalidDataException("Unsupported LiveSync snapshot.");
+        var keys = new HashSet<string>();
+        foreach (Material mat in frame.materials) {
+            if (mat == null || !Key(mat.key) || !keys.Add(mat.key) || mat.color == null || mat.color.Length != 3 ||
+                mat.color.Any(x => !Finite(x) || x < 0 || x > 1))
+                throw new InvalidDataException("Invalid LiveSync material.");
+        }
+        var meshKeys = new HashSet<string>();
+        long triangles = 0;
+        foreach (Mesh mesh in frame.meshes) {
+            if (mesh == null || !Key(mesh.key) || !meshKeys.Add(mesh.key) || !Key(mesh.material) || !keys.Contains(mesh.material) ||
+                mesh.positions == null || mesh.normals == null || mesh.positions.Length == 0 || mesh.positions.Length % 9 != 0 ||
+                mesh.positions.Length != mesh.normals.Length ||
+                mesh.positions.Any(x => !Finite(x) || Math.Abs(x) > 1000000) ||
+                mesh.normals.Any(x => !Finite(x) || Math.Abs(x) > 1.001))
+                throw new InvalidDataException("Invalid LiveSync mesh.");
+            triangles += mesh.positions.Length / 9;
+            if (triangles > MaxTriangles) throw new InvalidDataException("LiveSync triangle limit exceeded.");
+        }
+    }
+    static bool Finite(float x) { return !float.IsNaN(x) && !float.IsInfinity(x); }
+    static bool Key(string x) { return x != null && x.Length > 0 && x.Length <= 512 && !x.Any(char.IsControl); }
+
+    static void Publish(Frame frame) {
+        var materialKeys = new HashSet<string>();
+        foreach (Material mat in frame.materials) {
+            materialKeys.Add(mat.key);
+            Entry entry;
+            if (!Materials.TryGetValue(mat.key, out entry)) {
+                entry = new Entry { Writer = Call(Document, "CreateMaterialElement"), Asset = Call(T("MaterialAsset"), "Create") };
+                Materials.Add(mat.key, entry);
+            }
+            Set(entry.Asset, "Name", mat.key);
+            Call(entry.Asset, "SetPropertyColor", Static("MaterialAsset", "AlbedoColor"), mat.color[0], mat.color[1], mat.color[2], 1f);
+            Call(entry.Writer, "SetName", mat.key);
+            Call(entry.Writer, "SetMaterial", entry.Asset);
+        }
+        var seen = new HashSet<string>();
+        IList nodes = (IList)Activator.CreateInstance(typeof(List<>).MakeGenericType(T("HierarchyNode")));
+        foreach (Mesh mesh in frame.meshes) {
+            seen.Add(mesh.key);
+            Entry entry;
+            if (!Meshes.TryGetValue(mesh.key, out entry)) {
+                entry = new Entry { Writer = Call(Document, "CreateMeshElement"), Node = NextNode++ };
+                Meshes.Add(mesh.key, entry);
+            }
+            int vertices = mesh.positions.Length / 3;
+            ulong semantics = Convert.ToUInt64(E("VertexSemantic", "Positions")) | Convert.ToUInt64(E("VertexSemantic", "Normals"));
+            object asset = Call(T("MeshAsset"), "Create", (ulong)vertices, (ulong)vertices,
+                Enum.ToObject(T("VertexSemantic"), semantics), E("PolygonSize", "Triangle"));
+            try {
+                Call(asset, "InsertVertices", E("VertexSemantic", "Positions"), mesh.positions, 0UL, false);
+                Call(asset, "InsertVertices", E("VertexSemantic", "Normals"), mesh.normals, 0UL, false);
+                int[] indices = Enumerable.Range(0, vertices).ToArray();
+                Call(asset, "InsertIndices", indices, 0UL);
+                Call(asset, "SetMaterial", Materials[mesh.material].Asset);
+                Call(entry.Writer, "SetName", mesh.key);
+                Call(entry.Writer, "SetMesh", asset);
+                Call(entry.Writer, "SetInstances", new List<ulong> { entry.Node });
+            } finally { Dispose(asset); }
+            object node = Activator.CreateInstance(T("HierarchyNode"));
+            Set(node, "Id", entry.Node);
+            Set(node, "ParentId", Static("HierarchyNode", "InvalidNodeId"));
+            Set(node, "Type", E("HierarchyNodeType", "Mesh"));
+            Set(node, "Name", mesh.key);
+            Set(node, "Visibility", true);
+            Set(node, "LocalTransform", System.Numerics.Matrix4x4.Identity);
+            Set(node, "GeometryTransform", System.Numerics.Matrix4x4.Identity);
+            Set(node, "GlobalTransform", System.Numerics.Matrix4x4.Identity);
+            Set(node, "DataAsGuid", Get(entry.Writer, "ElementId"));
+            Call(node, "ComputeHash");
+            nodes.Add(node);
+        }
+        foreach (string key in Meshes.Keys.Where(k => !seen.Contains(k)).ToArray()) {
+            Call(Document, "DeleteElement", Get(Meshes[key].Writer, "ElementId"));
+            Dispose(Meshes[key].Writer); Meshes.Remove(key);
+        }
+        foreach (string key in Materials.Keys.Where(k => !materialKeys.Contains(k)).ToArray()) {
+            Call(Document, "DeleteElement", Get(Materials[key].Writer, "ElementId"));
+            Dispose(Materials[key].Writer); Dispose(Materials[key].Asset); Materials.Remove(key);
+        }
+        try {
+            Call(Call(Document, "GetSceneHierarchyElement"), "SetNodes", nodes);
+            if (!Initialized) { Call(Document, "InitComplete"); Initialized = true; }
+            Call(Document, "Push");
+            int notified = (int)Call(T("ActApp"), "PostAppNotify", E("ActAppType", "Lumion"), E("Notification", "OneShot"), 0UL);
+            Report("published", frame.meshes.Length + " meshes published; Lumion notification recipients: " + notified + ".");
+        } finally { foreach (object node in nodes) Dispose(node); }
+    }
+
+    static Type T(string name) {
+        Type type = Engine.GetType("LiveSyncNET." + name, true);
+        return type;
+    }
+    static object E(string type, string name) { return Enum.Parse(T(type), name); }
+    static object Static(string type, string property) { return T(type).GetProperty(property).GetValue(null, null); }
+    static object Get(object target, string property) { return target.GetType().GetProperty(property).GetValue(target, null); }
+    static void Set(object target, string property, object value) { target.GetType().GetProperty(property).SetValue(target, value, null); }
+    static object Call(object target, string name, params object[] args) {
+        bool isStatic = target is Type;
+        Type type = isStatic ? (Type)target : target.GetType();
+        var candidates = type.GetMethods(BindingFlags.Public | (isStatic ? BindingFlags.Static : BindingFlags.Instance));
+        foreach (MethodInfo method in candidates.Where(m => m.Name == name)) {
+            ParameterInfo[] pars = method.GetParameters();
+            if (pars.Length != args.Length) continue;
+            bool matches = true;
+            for (int i = 0; i < args.Length; i++)
+                if (args[i] != null && !pars[i].ParameterType.IsInstanceOfType(args[i])) { matches = false; break; }
+            if (matches) return method.Invoke(isStatic ? null : target, args);
+        }
+        throw new MissingMethodException(type.FullName, name);
+    }
+    static void Dispose(object value) { var item = value as IDisposable; if (item != null) item.Dispose(); }
+    static void Report(string status, string message) {
+        if (message.Length > 3000) message = message.Substring(0, 3000);
+        Console.Out.WriteLine(Json.Serialize(new { status = status, message = message }));
+        Console.Out.Flush();
+    }
+}
diff --git a/tools/lumion-bridge/Tests.cs b/tools/lumion-bridge/Tests.cs
new file mode 100644
index 0000000..d0af26d
--- /dev/null
+++ b/tools/lumion-bridge/Tests.cs
@@ -0,0 +1,39 @@
+using System;
+using System.IO;
+
+static class BridgeTests {
+    static int Main() {
+        RejectFrame(new byte[] { 0, 0, 0, 0 });
+        RejectFrame(new byte[] { 1, 0, 0, 4 }); // 64 MiB + 1, rejected before allocation.
+        RejectFrame(new byte[] { 3, 0 });
+        RejectFrame(new byte[] { 3, 0, 0, 0, 123 });
+        if (Bridge.ReadFrame(new MemoryStream(new byte[0])) != null) throw new Exception("EOF must stop.");
+        var valid = new byte[] { 2, 0, 0, 0, 123, 125 };
+        if (Bridge.ReadFrame(new MemoryStream(valid)).Length != 2) throw new Exception("Frame read failed.");
+        Bridge.Validate(new Frame {version=1, meshes=new Mesh[0], materials=new Material[0]});
+        Reject(new Frame {version=2, meshes=new Mesh[0], materials=new Material[0]});
+        var mat = new Material {key="a",color=new float[]{1,0,0}};
+        var mesh = new Mesh {key="one",material="a",positions=new float[9],normals=new float[9]};
+        var frame = new Frame {version=1,meshes=new Mesh[]{mesh},materials=new Material[]{mat}};
+        Bridge.Validate(frame);
+        mesh.positions[0] = float.NaN; Reject(frame); mesh.positions[0] = 0;
+        mesh.normals[0] = float.PositiveInfinity; Reject(frame); mesh.normals[0] = 0;
+        mesh.material = "missing"; Reject(frame); mesh.material = "a";
+        frame.meshes = new Mesh[]{mesh,mesh}; Reject(frame);
+        frame.meshes = new Mesh[]{mesh}; frame.materials = new Material[]{mat,mat}; Reject(frame);
+        frame.materials = new Material[]{mat}; mesh.key = new string('a',513); Reject(frame);
+        Console.WriteLine("LiveSync adapter validation tests passed.");
+        return 0;
+    }
+    static void RejectFrame(byte[] bytes) {
+        try { Bridge.ReadFrame(new MemoryStream(bytes)); }
+        catch (InvalidDataException) { return; }
+        catch (EndOfStreamException) { return; }
+        throw new Exception("Invalid frame accepted.");
+    }
+    static void Reject(Frame frame) {
+        try { Bridge.Validate(frame); }
+        catch (InvalidDataException) { return; }
+        throw new Exception("Invalid snapshot accepted.");
+    }
+}

+//! Bounded scene snapshots for the optional local Lumion bridge.
+//! Coordinates are metres, Y up; stable element GUIDs keep edited objects identifiable.
+use std::collections::BTreeMap;
+use std::io::{self, Write};
+
+use serde::Serialize;
+
+use super::{Model, P3, Scene, cross, sub, unit};
+
+pub const MAX_TRIANGLES: usize = 150_000;
+pub const MAX_FRAME_BYTES: usize = 64 * 1024 * 1024;
+
+#[derive(Serialize)]
+pub struct Frame {
+    pub version: u32,
+    pub meshes: Vec<Mesh>,
+    pub materials: Vec<Material>,
+}
+
+#[derive(Serialize)]
+pub struct Mesh {
+    pub key: String,
+    pub material: String,
+    pub positions: Vec<f32>,
+    pub normals: Vec<f32>,
+}
+
+#[derive(Serialize)]
+pub struct Material {
+    pub key: String,
+    pub color: [f32; 3],
+}
+
+/// Build only tessellated model solids. An empty snapshot deliberately removes old geometry.
+/// Textures, lights, cameras, annotations and point clouds are not exported by this version.
+pub fn snapshot(model: &Model) -> Result<Frame, String> {
+    let scene = Scene::new(model);
+    if scene.tris.len() > MAX_TRIANGLES {
+        return Err(format!("Lumion sync is limited to {MAX_TRIANGLES} triangles."));
+    }
+    let mut meshes = BTreeMap::<String, Mesh>::new();
+    let mut materials = BTreeMap::new();
+    for (i, tri) in scene.tris.iter().enumerate() {
+        let material = format!("BIMCraft-{:02x}{:02x}{:02x}", tri.color[0], tri.color[1], tri.color[2]);
+        materials.entry(material.clone()).or_insert_with(|| Material {
+            key: material.clone(),
+            color: tri.color.map(|v| f32::from(v) / 255.0),
+        });
+        let guid = model.guid(tri.owner);
+        // Linked display objects have synthetic owners, outside the root model.
+        let owner = if guid.is_nil() { format!("linked-{}", tri.owner) } else { guid.to_string() };
+        let key = format!("{owner}/{material}");
+        let mesh = meshes.entry(key.clone()).or_insert_with(|| Mesh {
+            key,
+            material,
+            positions: Vec::new(),
+            normals: Vec::new(),
+        });
+        let flat = unit(cross(sub(tri.p[1], tri.p[0]), sub(tri.p[2], tri.p[0])));
+        for (corner, point) in tri.p.iter().enumerate() {
+            mesh.positions.extend(position(*point)?);
+            let normal = scene.smooth[i].as_ref().map_or(flat, |normals| normals[corner]);
+            mesh.normals.extend(direction(normal)?);
+        }
+    }
+    Ok(Frame { version: 1, meshes: meshes.into_values().collect(), materials: materials.into_values().collect() })
+}
+
+fn position(p: P3) -> Result<[f32; 3], String> {
+    if !p.iter().all(|v| v.is_finite() && v.abs() <= 1e9) {
+        return Err("Lumion geometry contains an invalid coordinate.".into());
+    }
+    Ok([p[0] as f32 / 1000.0, p[2] as f32 / 1000.0, -p[1] as f32 / 1000.0])
+}
+
+fn direction(p: P3) -> Result<[f32; 3], String> {
+    if !p.iter().all(|v| v.is_finite() && v.abs() <= 1.001) {
+        return Err("Lumion geometry contains an invalid normal.".into());
+    }
+    Ok([p[0] as f32, p[2] as f32, -p[1] as f32])
+}
+
+/// Stop serialization before an oversized model can allocate an unbounded outgoing frame.
+pub fn encode(frame: &Frame) -> Result<Vec<u8>, String> {
+    struct Bounded(Vec<u8>);
+    impl Write for Bounded {
+        fn write(&mut self, data: &[u8]) -> io::Result<usize> {
+            if data.len() > MAX_FRAME_BYTES.saturating_sub(self.0.len()) {
+                return Err(io::Error::other("Lumion snapshot exceeds 64 MiB."));
+            }
+            self.0.extend_from_slice(data);
+            Ok(data.len())
+        }
+        fn flush(&mut self) -> io::Result<()> { Ok(()) }
+    }
+    let mut out = Bounded(Vec::new());
+    serde_json::to_writer(&mut out, frame).map_err(|e| e.to_string())?;
+    Ok(out.0)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::engine::Session;
+    use serde_json::json;
+
+    #[test]
+    fn coordinates_are_metres_y_up_and_reject_nonfinite_values() {
+        assert_eq!(position([1000.0, 2000.0, 3000.0]).unwrap(), [1.0, 3.0, -2.0]);
+        assert!(position([f64::NAN, 0.0, 0.0]).is_err());
+        assert!(position([f64::INFINITY, 0.0, 0.0]).is_err());
+        assert!(position([1e10, 0.0, 0.0]).is_err());
+    }
+
+    #[test]
+    fn wall_identity_survives_an_edit_and_delete_empties_the_snapshot() {
+        let mut s = Session::new();
+        let made = s.execute("wall", &json!({"points":[[0,0],[4000,0]]})).unwrap();
+        let first = snapshot(&s.model).unwrap();
+        assert!(!first.meshes.is_empty());
+        assert!(first.meshes.iter().all(|m| m.positions.len() == m.normals.len() && m.positions.len() % 9 == 0));
+        let keys: Vec<_> = first.meshes.iter().map(|m| &m.key).collect();
+        s.execute("move", &json!({"ids":made["ids"],"by":[1000,2000]})).unwrap();
+        let second = snapshot(&s.model).unwrap();
+        assert_eq!(keys, second.meshes.iter().map(|m| &m.key).collect::<Vec<_>>());
+        s.execute("undo", &json!({})).unwrap();
+        assert_eq!(encode(&first).unwrap(), encode(&snapshot(&s.model).unwrap()).unwrap());
+        s.execute("undo", &json!({})).unwrap();
+        assert!(snapshot(&s.model).unwrap().meshes.is_empty());
+        s.execute("redo", &json!({})).unwrap();
+        assert_eq!(encode(&first).unwrap(), encode(&snapshot(&s.model).unwrap()).unwrap());
+    }
+
+    #[test]
+    fn empty_frame_has_an_explicit_protocol_version() {
+        let frame = snapshot(&Session::new().model).unwrap();
+        let json: serde_json::Value = serde_json::from_slice(&encode(&frame).unwrap()).unwrap();
+        assert_eq!(json["version"], 1);
+        assert_eq!(json["meshes"], json!([]));
+    }
+}
